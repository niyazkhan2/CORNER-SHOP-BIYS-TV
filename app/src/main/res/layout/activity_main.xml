<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ecru"
    android:padding="@dimen/screen_pad">

    <!-- Top-left: clock + date (B-style) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="@color/ink"
            android:textSize="@dimen/clock_size"
            android:includeFontPadding="false"
            android:text="21:47" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_soft"
            android:textSize="16sp"
            android:text="Friday 20 November" />
    </LinearLayout>

    <!-- Top-right: phone-remote QR -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/remote_hint"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:gravity="end"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            android:text="Scan for\nphone remote" />

        <ImageView
            android:id="@+id/qr"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="Phone remote QR code" />
    </LinearLayout>

    <!-- Centre: logo -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="740dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:src="@drawable/csb_logo" />

    <!-- Bottom: the dock -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/dock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/ink_faint"
            android:textSize="13sp"
            android:text="@string/hint" />
    </LinearLayout>

    <!-- PS5 "waking" overlay, hidden by default -->
    <LinearLayout
        android:id="@+id/wake_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/red"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cream_text"
            android:textSize="110sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:text="PS5" />

        <TextView
            android:id="@+id/wake_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#F4D9CF"
            android:textSize="15sp"
            android:letterSpacing="0.3"
            android:text="WAKING UP · SWITCHING TO HDMI 2" />
    </LinearLayout>
</FrameLayout>
