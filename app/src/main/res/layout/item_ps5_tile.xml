<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="140dp"
    android:layout_marginEnd="@dimen/tile_gap"
    android:background="@drawable/tile_ps5"
    android:orientation="vertical"
    android:padding="18dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F4D9CF"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:text="HDMI 2" />

        <View
            android:id="@+id/ps5_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_amber" />
    </LinearLayout>

    <TextView
        android:id="@+id/ps5_label"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:textColor="@color/cream_text"
        android:textSize="52sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:text="PS5" />
</LinearLayout>
