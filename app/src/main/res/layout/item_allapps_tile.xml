<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tile_h"
    android:layout_height="@dimen/tile_h"
    android:background="@drawable/tile_app"
    android:orientation="vertical"
    android:gravity="center"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/allapps_glyph"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ink_soft"
        android:textSize="30sp"
        android:text="▦" />

    <TextView
        android:id="@+id/allapps_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink_soft"
        android:textSize="12sp"
        android:text="@string/all_apps" />
</LinearLayout>
