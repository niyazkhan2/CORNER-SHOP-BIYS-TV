<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: navy fill, red ring -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/navy" />
            <corners android:radius="@dimen/tile_radius" />
            <stroke android:width="3dp" android:color="@color/red" />
        </shape>
    </item>
    <!-- Resting -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ecru_tile" />
            <corners android:radius="@dimen/tile_radius" />
            <stroke android:width="1dp" android:color="@color/ecru_edge" />
        </shape>
    </item>
</selector>
